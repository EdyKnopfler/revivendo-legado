         font-family: Arial, sans-serif;
         font-size:   10px;
      }
      table {
         width: 1500px;
      }
      th {
          padding:    3px;
          background: navy;
          color:      white;
          text-align: left;
      }
   </style>
</head>

<body>
   <h1>Relatório de Clientes</h1>
   
